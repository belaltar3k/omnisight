{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/sentinel-backend/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/sentinel-backend/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/sentinel-backend",
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api-gateway/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "camera-service": {
      "type": "application",
      "root": "apps/camera-service",
      "entryFile": "main",
      "sourceRoot": "apps/camera-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/camera-service/tsconfig.app.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "incident-service": {
      "type": "application",
      "root": "apps/incident-service",
      "entryFile": "main",
      "sourceRoot": "apps/incident-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/incident-service/tsconfig.app.json"
      }
    },
    "sentinel-backend": {
      "type": "application",
      "root": "apps/sentinel-backend",
      "entryFile": "main",
      "sourceRoot": "apps/sentinel-backend/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sentinel-backend/tsconfig.app.json"
      }
    },
    "user-service": {
      "type": "application",
      "root": "apps/user-service",
      "entryFile": "main",
      "sourceRoot": "apps/user-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/user-service/tsconfig.app.json"
      }
    },
    "alert-service": {
      "type": "application",
      "root": "apps/alert-service",
      "entryFile": "main",
      "sourceRoot": "apps/alert-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/alert-service/tsconfig.app.json"
      }
    }
  }
}