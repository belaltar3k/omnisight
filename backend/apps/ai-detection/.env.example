# AI Detection Service — Native Mode Configuration
# Copy this to .env and adjust values

# Running mode: "native" (host GPU) or "docker" (shared memory IPC)
MODE=native
DEVICE=cuda

# RTSP camera streams (comma-separated or JSON array)
RTSP_URLS=rtsp://localhost:8554/camera1

# Edge integration (must match backend/.env EDGE_SYNC_SECRET)
EDGE_SYNC_SECRET=some_random_secret_123
EDGE_NODE_CODE=edge-node-01

# Incident service URL (localhost when running natively)
INCIDENT_SERVICE_URL=http://localhost:3003

# Redis (edge-cache mapped to port 6380 on host)
REDIS_HOST=localhost
REDIS_PORT=6380

# Model weights (auto-resolved from ai/weights/ if left empty)
WEIGHTS_DIR=
SKELNET_WEIGHTS=
VIDEOMAE_WEIGHTS=
WEAPON_WEIGHTS=
POSE_MODEL=

# Disabled models (comma-separated, e.g.: video_mae,paan)
DISABLED_MODELS=
DISABLED_SA_MODULES=

# Fusion parameters
ANOMALY_THRESHOLD=0.55
TARGET_FPS=15
